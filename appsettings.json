{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cognigy": {
    "BaseUrl": "https://cognigy-api-na1.nicecxone.com/",
    "ApiKey": "<your-cognigy-api-key>"
  },
  "PromptManager": {
    "BaseUrl": "",
    "ExtractIntentsPath": "/api/intents/extract",
    "ApiKeyHeaderName": "prompt-manager-api-key",
    "ApiKey": "",
    "TimeoutSeconds": 30
  },
  "FlowCache": {
    "RefreshMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
